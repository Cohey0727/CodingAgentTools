#!/usr/bin/env bash
# Launch an agent against one provider from configs.jsonc.
#
# Generated by `make setup`. The provider, the agent and the paths below are
# baked in at that point. Re-run `make setup` if you move the project.
#
# Nothing about the agent is written here: which command to exec, which
# variables carry the token, the endpoint, the headers and each model slot all
# come from that agent's "launch" and "slots" in configs.jsonc.

set -euo pipefail

PROVIDER="@@PROVIDER@@"
AGENT="@@AGENT@@"
COMMON="@@COMMON@@"
SELF="${0##*/}"

if [[ ! -f "$COMMON" ]]; then
  echo "$SELF: file not found at $COMMON" >&2
  echo "  re-run 'make setup' from the project root." >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$COMMON"

# configs.jsonc is the whole configuration; the .env beside it holds the values
# its "${NAME}" references point at. Neither is exported into this shell — only
# the resolved values below reach the agent.
settings_resolve "$AGENT"
models_resolve "$PROVIDER" "$AGENT"
require_key "$SELF"

export "$S_TOKEN_VAR=$M_API_KEY"
export "$S_BASE_URL_VAR=$M_BASE_URL"

HEADERS=$(custom_headers)
if [[ -n "$HEADERS" && -n "$S_HEADERS_VAR" ]]; then
  export "$S_HEADERS_VAR=$HEADERS"
fi

# One model per slot. Assignment is unconditional — a variable inherited from an
# outer launcher session would otherwise pin this one to the outer provider.
for slot in $M_SLOT_NAMES; do
  var="M_SLOT_$slot"
  export "$slot=${!var}"
done

if [[ -n "$S_AUTO_COMPACT_WINDOW_VAR" && -n "$M_AUTO_COMPACT_WINDOW" ]]; then
  export "$S_AUTO_COMPACT_WINDOW_VAR=$M_AUTO_COMPACT_WINDOW"
fi

# "env" from the provider's own block, exported as-is.
eval "$M_ENV_SH"

# Cleared last: any of these still set would shadow what was exported above.
for var in $S_UNSET_VARS; do
  unset "$var"
done

# shellcheck disable=SC2086  # word-splitting the default args is intended
exec "$S_EXEC" $M_ARGS "$@"
