#!/usr/bin/env bash
# Launch Claude Code against an Anthropic-compatible provider.
#
# Generated by `make setup`. The paths below are baked in from the directory
# you ran `make setup` from. Re-run `make setup` if you move the project.

set -euo pipefail

PROVIDER_DIR="@@PROVIDER_DIR@@"
COMMON="@@COMMON@@"
ENV_FILE="$PROVIDER_DIR/.env"
SELF="${0##*/}"

for f in "$COMMON" "$ENV_FILE" "$PROVIDER_DIR/models.json"; do
  if [[ ! -f "$f" ]]; then
    echo "$SELF: file not found at $f" >&2
    echo "  re-run 'make setup' from the project root." >&2
    exit 1
  fi
done

# shellcheck disable=SC1090
source "$COMMON"

# models.json is the single source of truth for every model slot; .env carries
# only the token, the endpoint and any extra headers.
load_settings "$ENV_FILE"
require_settings "$SELF" "$ENV_FILE"
models_resolve "$PROVIDER_DIR"

export ANTHROPIC_AUTH_TOKEN="$CFG_TOKEN"
export ANTHROPIC_BASE_URL="$CFG_BASE_URL"

# HEADERS ("Name: Value" lines) is exactly what ANTHROPIC_CUSTOM_HEADERS takes.
if [[ -n "$CFG_HEADERS" ]]; then
  export ANTHROPIC_CUSTOM_HEADERS="$CFG_HEADERS"
fi

# One model per slot, each the id tagged for it in models.json. Assignment is
# unconditional: an ANTHROPIC_* inherited from an outer launcher session would
# otherwise pin this one to the outer provider's model.
export ANTHROPIC_MODEL="$M_CLAUDE_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$M_CLAUDE_OPUS_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$M_CLAUDE_SONNET_MODEL"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$M_CLAUDE_FABLE_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$M_CLAUDE_HAIKU_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$M_CLAUDE_SUBAGENT_MODEL"

# The main model's context window doubles as Claude Code's auto-compact threshold.
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$M_CLAUDE_AUTO_COMPACT_WINDOW"

# "claude": { "env": { ... } } from models.json, exported as-is.
eval "$M_CLAUDE_ENV_SH"

DEFAULT_ARGS="$M_CLAUDE_ARGS"
strip_metadata

# A stale ANTHROPIC_API_KEY in the environment would shadow AUTH_TOKEN.
unset ANTHROPIC_API_KEY

# shellcheck disable=SC2086  # word-splitting DEFAULT_ARGS is intended
exec claude $DEFAULT_ARGS "$@"
