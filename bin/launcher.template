#!/usr/bin/env bash
# Launch Claude Code against an Anthropic-compatible provider.
#
# Generated by `make setup`. The paths below are baked in from the directory
# you ran `make setup` from. Re-run `make setup` if you move the project.

set -euo pipefail

PROVIDER="@@PROVIDER@@"
COMMON="@@COMMON@@"
SELF="${0##*/}"

if [[ ! -f "$COMMON" ]]; then
  echo "$SELF: file not found at $COMMON" >&2
  echo "  re-run 'make setup' from the project root." >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$COMMON"

# configs.json is the whole configuration; the .env beside it holds the values
# its "${NAME}" references point at. Neither is exported into this shell — only
# the resolved values below reach `claude`.
models_resolve "$PROVIDER"
require_settings "$SELF"

export ANTHROPIC_AUTH_TOKEN="$M_API_KEY"
export ANTHROPIC_BASE_URL="$M_BASE_URL"

CUSTOM_HEADERS=$(claude_custom_headers)
if [[ -n "$CUSTOM_HEADERS" ]]; then
  export ANTHROPIC_CUSTOM_HEADERS="$CUSTOM_HEADERS"
fi

# One model per slot: configs.json tags each model with the variable it fills,
# and models_resolve returns that variable's value as M_<name>. Assignment is
# unconditional — an ANTHROPIC_* inherited from an outer launcher session would
# otherwise pin this one to the outer provider's model.
export ANTHROPIC_MODEL="$M_ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$M_ANTHROPIC_DEFAULT_OPUS_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$M_ANTHROPIC_DEFAULT_SONNET_MODEL"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$M_ANTHROPIC_DEFAULT_FABLE_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$M_ANTHROPIC_DEFAULT_HAIKU_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$M_CLAUDE_CODE_SUBAGENT_MODEL"

# The main model's context window doubles as Claude Code's auto-compact threshold.
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$M_CLAUDE_CODE_AUTO_COMPACT_WINDOW"

# "claude": { "env": { ... } } from configs.json, exported as-is.
eval "$M_CLAUDE_ENV_SH"

# A stale ANTHROPIC_API_KEY in the environment would shadow AUTH_TOKEN.
unset ANTHROPIC_API_KEY

# shellcheck disable=SC2086  # word-splitting the default args is intended
exec claude $M_CLAUDE_ARGS "$@"
