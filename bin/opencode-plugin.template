@@MARKER@@
// OpenCode resolves a plugin's npm imports from where the file really lives, so
// the implementation in the repo cannot import @opencode-ai/plugin itself: only
// a file inside the config dir, where OpenCode installs it, can. Every plugin
// under opencode/plugin/ therefore exports `plugin({ tool })` and gets one of
// these, generated by `make setup-skills` with its path baked in.
import { tool } from "@opencode-ai/plugin"
import { plugin } from "@@IMPL@@"

export const Plugin = plugin({ tool })
