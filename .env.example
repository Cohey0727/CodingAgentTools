# Secrets for configs.json. Every "${NAME}" in that file is read from here, so
# this is the only file that ever holds a key. `make setup` copies it to .env
# (chmod 600) and fills in what you paste at its prompts.
#
# The file is sourced by bash, so a value may be computed at use time:
#   GTR_CF_ACCESS_TOKEN="$(cloudflared access token --app=https://example.com)"

# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=

# https://platform.moonshot.ai/console/api-keys
KIMI_API_KEY=

# https://platform.xiaomimimo.com/token-plan
MIMO_API_KEY=

# https://www.minimax.io/platform
MINIMAX_API_KEY=

# llama-server takes no auth, but the CLIs require the value to be set, so any
# non-empty string works. Set to empty to hide the provider from the generated
# pi and OpenCode configs.
LOCAL_API_KEY=local
GTR_API_KEY=gtr

# Cloudflare Access service token for the gtr endpoint: Zero Trust -> Access ->
# Service Auth -> Service Tokens, plus a Service Auth policy on the gtr-llama
# application that allows it. Without these, Access answers every request with a
# 302 to its login page.
GTR_CF_ACCESS_CLIENT_ID=
GTR_CF_ACCESS_CLIENT_SECRET=
