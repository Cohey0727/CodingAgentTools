# The values configs.json refers to. Every "${NAME}" there is read from here, so
# this is the only file that ever holds a key. `make setup` copies it to .env
# (chmod 600) and fills in what you paste at its prompts.
#
# The file is sourced by bash, so a value may be computed at use time:
#   GTR_CF_ACCESS_TOKEN="$(cloudflared access token --app=https://example.com)"
#
# Commented-out lines below are the "${NAME:-fallback}" references: configs.json
# already carries a working default, and setting one here overrides it. That is
# how a provider is pointed at another route — a regional host, a metered
# endpoint, a proxy or gateway in front of it — without editing configs.json.

# --- deepseek --- https://platform.deepseek.com/
DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# --- glm --- https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=
#GLM_BASE_URL=https://api.z.ai/api/anthropic

# --- kimi --- https://platform.moonshot.ai/console/api-keys
# The default endpoint is the coding subscription plan; the override below is
# pay-as-you-go (metered) billing.
KIMI_API_KEY=
#KIMI_BASE_URL=https://api.moonshot.ai/anthropic

# --- mimo --- https://platform.xiaomimimo.com/token-plan
# Token Plan tokens start with "tp-", pay-as-you-go API keys with "sk-". The
# default endpoint is the global Token Plan host; the overrides below are the
# China Token Plan host and the metered one.
MIMO_API_KEY=
#MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
#MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic

# --- minimax --- https://www.minimax.io/platform
MINIMAX_API_KEY=
#MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# --- local --- a llama-server on this machine
# It takes no auth and configs.json already falls back to a placeholder key, so
# both lines are only here to be overridden.
#LOCAL_API_KEY=local
#LOCAL_BASE_URL=http://127.0.0.1:11301

# --- gtr --- a llama-server behind Cloudflare Access
# Required: a service token from Zero Trust -> Access -> Service Auth -> Service
# Tokens, plus a Service Auth policy on the application that allows it. Without
# these, Access answers every request with a 302 to its login page.
GTR_CF_ACCESS_CLIENT_ID=
GTR_CF_ACCESS_CLIENT_SECRET=
#GTR_API_KEY=gtr
#GTR_BASE_URL=https://gtr-llama.spaghetti-monster.com
