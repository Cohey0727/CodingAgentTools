{
  "schemas": {
    "self": "このセッションの Claude 自身がレビュアーの1人として直接レビューを書く。外部プロセスは起動しない",
    "stdin": "任意コマンド。`command` をそのまま実行し、stdin にプロンプト・stdout に回答"
  },
  "llms": [
    {
      "name": "claude",
      "label": "Anthropic Claude (このセッション自身)",
      "enabled": true,
      "schema": "self",
      "notes": "外部LLMの回答を読む前に、独立したレビューを自分で書き切ること (回答を見た後だと引きずられる)"
    },
    {
      "name": "deepseek",
      "label": "DeepSeek (opencode)",
      "enabled": true,
      "schema": "stdin",
      "model": {
        "provider": "deepseek",
        "role": "small"
      },
      "command": "opencode run --model {model} --agent plan",
      "timeout_ms": 1200000,
      "notes": "--agent plan で read-only"
    },
    {
      "name": "glm",
      "label": "Zhipu AI GLM (opencode)",
      "enabled": true,
      "schema": "stdin",
      "model": {
        "provider": "glm",
        "role": "small"
      },
      "command": "opencode run --model {model} --agent plan",
      "timeout_ms": 1200000,
      "notes": "--agent plan で read-only"
    }
  ]
}
