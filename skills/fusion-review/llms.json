{
  "schemas": {
    "self": "このセッションのホストLLM自身がレビュアーの1人として直接レビューを書く。外部プロセスは起動しない",
    "stdin": "任意コマンド。`command` をそのまま実行し、stdin にプロンプト・stdout に回答"
  },
  "llms": [
    {
      "name": "self",
      "label": "このセッション自身 (ホストLLM)",
      "enabled": true,
      "schema": "self",
      "notes": "外部LLMの回答を読む前に、独立したレビューを自分で書き切ること (回答を見た後だと引きずられる)"
    },
    {
      "name": "deepseek-commandcode",
      "label": "DeepSeek V4.1 Flash (Command Code)",
      "enabled": true,
      "schema": "stdin",
      "command": "opencode run --model commandcode-openai/deepseek/deepseek-v4.1-flash --agent plan",
      "timeout_ms": 1200000,
      "notes": "--agent plan で read-only"
    },
