# GLM (Z.ai / Zhipu AI): the two settings that cannot live in git. Everything
# about models — ids, limits and the tags that pick each slot — is in
# models.json next to this file, which all three CLIs read.
# Reference: https://docs.z.ai/devpack/tool/claude

# Required: get an API key at https://z.ai/manage-apikey/apikey-list
API_TOKEN=

# Anthropic-compatible endpoint, shared by Claude Code, OpenCode and pi.
BASE_URL=https://api.z.ai/api/anthropic
