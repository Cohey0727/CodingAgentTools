# Kimi (Moonshot AI): the two settings that cannot live in git. Everything about
# models — ids, limits and the tags that pick each slot — is in models.json next
# to this file, which all three CLIs read.
# Reference: https://platform.moonshot.ai/docs

# Required: get an API key at https://platform.moonshot.ai/console/api-keys
API_TOKEN=

# Anthropic-compatible endpoint, shared by Claude Code, OpenCode and pi. Two are
# available:
#   https://api.kimi.com/coding       -> Kimi coding subscription plan (default)
#   https://api.moonshot.ai/anthropic -> pay-as-you-go (metered) billing
BASE_URL=https://api.kimi.com/coding
