# Kimi (Moonshot AI) settings. One file drives all three CLIs: Claude
# Code, OpenCode and pi. Every setting below is generic; the commented-out
# lines further down are per-CLI overrides you only need when one CLI should
# differ from the rest.
# Reference: https://platform.moonshot.ai/docs

# The launcher command is derived from this: claude<NAME>
# -> claudekimi. The bare "kimi" would collide with
# Moonshot's official Kimi CLI.
NAME=kimi

# Required: get an API key at https://platform.moonshot.ai/console/api-keys
API_TOKEN=

# Anthropic-compatible endpoint, shared by all three CLIs. Two are available:
#   https://api.kimi.com/coding       -> Kimi coding subscription plan (default)
#   https://api.moonshot.ai/anthropic -> pay-as-you-go (metered) billing
BASE_URL=https://api.kimi.com/coding

# MODEL fills every main model slot, SMALL_MODEL every cheap one (Claude
# Code's haiku + subagent, OpenCode's small model, pi's second Ctrl+P entry).
MODEL=kimi-k3
SMALL_MODEL=kimi-k3

# Model limits: pi writes them into its generated models.json, and Claude
# Code takes CONTEXT_WINDOW as its auto-compact window. INPUT is "text" or
# "text,image"; REASONING says whether the models support extended thinking.
CONTEXT_WINDOW=1048576
MAX_TOKENS=131072
REASONING=true
INPUT=text,image

# Claude Code-only marker appended to every model slot; it selects the
# 1M-context variant. OpenCode and pi send plain ids.
CLAUDE_MODEL_SUFFIX=[1m]

# Default CLI options prepended to every claude<NAME> launch (word-split).
# OpenCode and pi have no launcher, so this is Claude Code only.
ARGS=

# Claude Code extras, exported as-is.
ENABLE_TOOL_SEARCH=false
CLAUDE_CODE_EFFORT_LEVEL=max

# --------------------------------------------------------------- overrides
# Everything below is optional — uncomment only to override the defaults
# derived from the settings above.

# Launcher command name. Default: claudekimi.
#COMMAND=claudekimi

# Default CLI options for claude<NAME>. Default: the value of ARGS.
#CLAUDE_ARGS=--permission-mode plan

# Token and endpoint for Claude Code. Default: API_TOKEN and BASE_URL.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic

# Models per CLI. Default: MODEL plus CLAUDE_MODEL_SUFFIX for Claude
# Code (kimi-k3[1m]) and the plain id for OpenCode and pi (kimi-k3). The
# opus / sonnet / fable slots follow ANTHROPIC_MODEL when it is set.
#ANTHROPIC_MODEL=kimi-k3[1m]
#ANTHROPIC_DEFAULT_HAIKU_MODEL=kimi-k3[1m]
#CLAUDE_CODE_SUBAGENT_MODEL=kimi-k3[1m]
#OPENCODE_MODEL=kimi-k3
#OPENCODE_SMALL_MODEL=kimi-k3

# Ids OpenCode lists on top of MODEL and SMALL_MODEL, space-separated. Claude
# Code and pi reach another model with --model; OpenCode has no launcher to
# pass one. Default: none.
#OPENCODE_EXTRA_MODELS=
#PI_MODEL=kimi-k3
#PI_SMALL_MODEL=kimi-k3

# Limits for SMALL_MODEL when it is a different size than MODEL.
# Default: CONTEXT_WINDOW / MAX_TOKENS.
#SMALL_CONTEXT_WINDOW=1048576
#SMALL_MAX_TOKENS=131072

# Claude Code's auto-compact window. Default: CONTEXT_WINDOW.
#CLAUDE_CODE_AUTO_COMPACT_WINDOW=1048576
