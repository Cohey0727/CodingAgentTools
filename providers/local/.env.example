# Local llama.cpp settings. One file drives all three CLIs: Claude Code,
# OpenCode and pi. Every setting below is generic; the commented-out lines
# further down are per-CLI overrides you only need when one CLI should
# differ from the rest.
#
# Unlike the hosted providers there is no account and no key: this points at a
# llama-server running on your own machine. llama-server serves the Anthropic
# shape on /v1/messages, so the launchers talk to it directly.
# Reference: https://github.com/ggml-org/llama.cpp/tree/master/tools/server

# The launcher command is derived from this: claude<NAME>
# -> claudelocal.
NAME=local

# llama-server takes no auth. The CLIs still require the variable to be set,
# so any non-empty string works.
API_TOKEN=local

# Anthropic-compatible endpoint, shared by all three CLIs.
#
# The llama-server behind it is LlamaGate (~/Workspace/LlamaGate): `just start`
# there brings it up on 11301, `just profiles` lists the models it can load and
# `just start <profile>` swaps to one. Nothing answers while it is down, so a
# request fails outright rather than falling back to anything else.
BASE_URL=http://127.0.0.1:11301

# MODEL fills every main model slot, SMALL_MODEL every cheap one (Claude
# Code's haiku + subagent, OpenCode's small model, pi's second Ctrl+P entry).
# One server serves one model, so both slots are the same id.
#
# The id is a label, not a selector: llama-server answers with whatever it has
# loaded and ignores the name the request asks for, so a fixed "default"
# survives swapping the model on the server. Only a multi-model llama-server
# that routes by name needs the id to match its --alias.
MODEL=default
SMALL_MODEL=default

# Model limits: pi writes them into its generated models.json, and Claude
# Code takes CONTEXT_WINDOW as its auto-compact window. INPUT is "text" or
# "text,image"; REASONING says whether the models support extended thinking.
#
# CONTEXT_WINDOW must not exceed the server's --ctx-size, which LlamaGate takes
# from CTX in the active profile, or requests fail once the conversation grows
# past it. 262144 is what the profiles carrying a 35B A3B model set.
CONTEXT_WINDOW=262144
MAX_TOKENS=32768
REASONING=true
INPUT=text

# Default CLI options prepended to every claude<NAME> launch (word-split).
# OpenCode and pi have no launcher, so this is Claude Code only.
ARGS=

# Claude Code extras, exported as-is. A 35B A3B model on one machine is far
# slower than the hosted providers, so the effort level stays low.
CLAUDE_CODE_EFFORT_LEVEL=low

# --------------------------------------------------------------- overrides
# Everything below is optional — uncomment only to override the defaults
# derived from the settings above.

# Launcher command name. Default: claudelocal.
#COMMAND=claudelocal

# Default CLI options for claude<NAME>. Default: the value of ARGS.
#CLAUDE_ARGS=--permission-mode plan

# Token and endpoint for Claude Code. Default: API_TOKEN and BASE_URL.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=http://127.0.0.1:11301

# Models per CLI. Default: MODEL for the main slots, SMALL_MODEL for the
# cheap ones. The opus / sonnet / fable slots follow ANTHROPIC_MODEL when set.
#ANTHROPIC_MODEL=default
#ANTHROPIC_DEFAULT_HAIKU_MODEL=default
#CLAUDE_CODE_SUBAGENT_MODEL=default
#OPENCODE_MODEL=default
#OPENCODE_SMALL_MODEL=default

# Ids OpenCode lists on top of MODEL and SMALL_MODEL, space-separated. Claude
# Code and pi reach another model with --model; OpenCode has no launcher to
# pass one. Default: none.
#OPENCODE_EXTRA_MODELS=
#PI_MODEL=default
#PI_SMALL_MODEL=default

# Limits for SMALL_MODEL when it is a different size than MODEL.
# Default: CONTEXT_WINDOW / MAX_TOKENS.
#SMALL_CONTEXT_WINDOW=262144
#SMALL_MAX_TOKENS=32768

# Claude Code's auto-compact window. Default: CONTEXT_WINDOW.
#CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144

# Marker appended to every Claude Code model slot (Claude Code-only syntax).
# Default: none.
#CLAUDE_MODEL_SUFFIX=[1m]
