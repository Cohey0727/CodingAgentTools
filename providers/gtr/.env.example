# gtr settings: a llama.cpp server on another machine. One file drives all
# three CLIs: Claude Code, OpenCode and pi. Every setting below is generic;
# the commented-out lines further down are per-CLI overrides you only need
# when one CLI should differ from the rest.
#
# The server is a llama-server published as gtr-llama.spaghetti-monster.com
# through a Cloudflare tunnel and gated by Cloudflare Access. llama-server
# serves the Anthropic shape on /v1/messages, so the CLIs talk to it directly
# once the Access headers below are set.
# Reference: https://github.com/ggml-org/llama.cpp/tree/master/tools/server

# The launcher command is derived from this: claude<NAME>
# -> claudegtr.
NAME=gtr

# llama-server takes no auth unless it was started with --api-key. The CLIs
# still require the variable to be set, so any non-empty string works.
API_TOKEN=gtr

# Anthropic-compatible endpoint, shared by all three CLIs.
BASE_URL=https://gtr-llama.spaghetti-monster.com

# Extra request headers, one "Name: Value" per line, sent by all three CLIs.
# Cloudflare Access answers requests without them with a 302 to its login
# page, so a service token is required: Zero Trust -> Access -> Service Auth
# -> Service Tokens, plus a Service Auth policy on the gtr-llama application
# that allows it.
#
#   HEADERS="CF-Access-Client-Id: <client id>.access
#   CF-Access-Client-Secret: <client secret>"
#
# A short-lived user token works too. The file is sourced by bash, so the
# value can be computed at launch, after `cloudflared access login <BASE_URL>`:
#
#   HEADERS="cf-access-token: $(cloudflared access token --app=https://gtr-llama.spaghetti-monster.com)"
#
# claudegtr evaluates it on every launch and pi on every request; OpenCode
# reads a copy taken when `make opencode-global` ran.
HEADERS=

# MODEL fills every main model slot, SMALL_MODEL every cheap one (Claude
# Code's haiku + subagent, OpenCode's small model, pi's second Ctrl+P entry).
# One server serves one model, so both slots are the same id.
#
# The id is a label, not a selector: llama-server answers with whatever it has
# loaded and ignores the name the request asks for, so a fixed "default"
# survives swapping the model on the server. Only a multi-model llama-server
# that routes by name needs the id to match its --alias.
MODEL=default
SMALL_MODEL=default

# Model limits: pi writes them into its generated models.json, and Claude
# Code takes CONTEXT_WINDOW as its auto-compact window. INPUT is "text" or
# "text,image"; REASONING says whether the models support extended thinking.
#
# CONTEXT_WINDOW must not exceed the server's --ctx-size, or requests fail
# once the conversation grows past it.
CONTEXT_WINDOW=262144
MAX_TOKENS=32768
REASONING=true
INPUT=text

# Default CLI options prepended to every claude<NAME> launch (word-split).
# OpenCode and pi have no launcher, so this is Claude Code only.
ARGS=

# Claude Code extras, exported as-is. A single self-hosted model is far slower
# than the hosted providers, so the effort level stays low.
CLAUDE_CODE_EFFORT_LEVEL=low

# OpenCode only. A lean agent for this provider: a short system prompt in place
# of OpenCode's stock one, and only bash / edit / read / write / grep / glob —
# no skill list, no subagents, no todo or webfetch tools. Cuts the fixed part of
# every request from ~10k tokens to ~4k, which is what makes a server that
# prefills at a few hundred tokens a second answer in seconds rather than
# minutes. `opencode` starts on this agent while gtr is the default provider;
# Tab switches to the stock build agent.
OPENCODE_LEAN=true

# OpenCode compacts a session once it fills the context, so this is the window
# a conversation may grow into before it is summarised — not the server's
# capacity. CONTEXT_WINDOW (the server's --ctx-size) would let a session reach
# a size this server needs minutes to prefill.
OPENCODE_CONTEXT_WINDOW=16384
OPENCODE_MAX_TOKENS=4096

# --------------------------------------------------------------- overrides
# Everything below is optional — uncomment only to override the defaults
# derived from the settings above.

# Launcher command name. Default: claudegtr.
#COMMAND=claudegtr

# Default CLI options for claude<NAME>. Default: the value of ARGS.
#CLAUDE_ARGS=--permission-mode plan

# Token, endpoint and headers for Claude Code. Default: API_TOKEN, BASE_URL
# and HEADERS.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=https://gtr-llama.spaghetti-monster.com
#ANTHROPIC_CUSTOM_HEADERS=

# Models per CLI. Default: MODEL for the main slots, SMALL_MODEL for the
# cheap ones. The opus / sonnet / fable slots follow ANTHROPIC_MODEL when set.
#ANTHROPIC_MODEL=default
#ANTHROPIC_DEFAULT_HAIKU_MODEL=default
#CLAUDE_CODE_SUBAGENT_MODEL=default
#OPENCODE_MODEL=default
#OPENCODE_SMALL_MODEL=default

# Ids OpenCode lists on top of MODEL and SMALL_MODEL, space-separated. Claude
# Code and pi reach another model with --model; OpenCode has no launcher to
# pass one. Default: none.
#OPENCODE_EXTRA_MODELS=
#PI_MODEL=default
#PI_SMALL_MODEL=default

# Limits for SMALL_MODEL when it is a different size than MODEL.
# Default: CONTEXT_WINDOW / MAX_TOKENS.
#SMALL_CONTEXT_WINDOW=262144
#SMALL_MAX_TOKENS=32768

# Claude Code's auto-compact window. Default: CONTEXT_WINDOW.
#CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144

# Marker appended to every Claude Code model slot (Claude Code-only syntax).
# Default: none.
#CLAUDE_MODEL_SUFFIX=[1m]
