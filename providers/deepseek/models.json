// DeepSeek models. Claude Code, OpenCode and pi all read this file; the token
// and the endpoint live in .env.
// Reference: https://api-docs.deepseek.com/guides/agent_integrations/claude_code
{
  "name": "deepseek",

  // Applied to every model below that does not set the field itself.
  "defaults": {
    "context_window": 1000000,
    "max_tokens": 384000,
    "reasoning": true,
    "input": ["text"]
  },

  "claude": {
    // Exported as-is to `claude` by the launcher.
    "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" }
  },

  "models": [
    { "id": "deepseek-v4-pro", "tags": ["default"] },
    { "id": "deepseek-v4-flash", "tags": ["small"] },

    // No tag: offered in OpenCode and pi, fills no Claude Code slot. Reach it
    // from Claude Code with --model.
    { "id": "deepseek-v4-flash-vision-exp", "input": ["text", "image"] },

    // Served but absent from both GET /models and the pricing docs, and the id
    // says it stops answering on 09-10.
    { "id": "deepseek-v4.1-flash-expires-on-0910" }
  ]
}
