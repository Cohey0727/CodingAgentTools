# DeepSeek: the two settings that cannot live in git. Everything about models —
# ids, limits and the tags that pick each slot — is in models.json next to this
# file, which all three CLIs read.
# Reference: https://api-docs.deepseek.com/guides/agent_integrations/claude_code

# Required: get an API key at https://platform.deepseek.com/
API_TOKEN=

# Anthropic-compatible endpoint, shared by Claude Code, OpenCode and pi.
BASE_URL=https://api.deepseek.com/anthropic
