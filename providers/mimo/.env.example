# MiMo (Xiaomi): the two settings that cannot live in git. Everything about
# models — ids, limits and the tags that pick each slot — is in models.json next
# to this file, which all three CLIs read.
# Reference: https://mimo.mi.com/docs

# Required: get an API key at https://platform.xiaomimimo.com/token-plan
# Token Plan tokens start with "tp-", pay-as-you-go API keys with "sk-".
API_TOKEN=

# Anthropic-compatible endpoint, shared by Claude Code, OpenCode and pi. Three
# are available:
#   https://token-plan-sgp.xiaomimimo.com/anthropic -> Token Plan subscription, global (default)
#   https://token-plan-cn.xiaomimimo.com/anthropic  -> Token Plan subscription, China accounts
#   https://api.xiaomimimo.com/anthropic            -> pay-as-you-go (metered) billing
BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
