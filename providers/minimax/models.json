// MiniMax models. Claude Code, OpenCode and pi all read this file; the token
// and the endpoint live in .env.
{
  // The launcher is claude<name>. "mmx", not "minimax": both bare names are
  // taken on a typical machine (minimax -> official MiniMax Code app,
  // mmx -> unrelated bun tool).
  "name": "mmx",

  "defaults": {
    "context_window": 1000000,
    "max_tokens": 128000,
    "reasoning": true,
    "input": ["text", "image"]
  },

  "claude": {
    "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" }
  },

  "models": [
    { "id": "MiniMax-M3", "tags": ["default", "small"] }
  ]
}
