# MiniMax: the two settings that cannot live in git. Everything about models —
# ids, limits and the tags that pick each slot — is in models.json next to this
# file, which all three CLIs read.

# Required: get an API key at https://www.minimax.io/platform
API_TOKEN=

# Anthropic-compatible endpoint, shared by Claude Code, OpenCode and pi.
BASE_URL=https://api.minimax.io/anthropic
