// Every provider: its endpoint, the models it serves, and the tags naming the
// slot each model fills. "${NAME}" and "${NAME:-fallback}" resolve from the
// .env beside this file, so no secret is written here. Fields: see README.
{
  // Deep-merged, key by key, into the generated opencode.json last, so a key
  // here wins.
  "opencode": {
    "overrides": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "small_model": "opencode-go/deepseek-v4.1-flash",

      "permission": "allow",

      // OpenCode fetches an unpinned plugin from npm at every start. The TUI
      // half of a plugin is registered in tui.json by `make setup` instead.
      "plugin": ["@slkiser/opencode-quota", "@tarquinen/opencode-dcp", "opencode-handoff"],

      "mcp": {
        // The persistent profile keeps logins across restarts. Chrome locks a
        // profile to one browser, so only one agent can drive it at a time.
        "playwright": {
          "type": "local",
          "command": ["npx", "@playwright/mcp@latest", "--user-data-dir", "{env:HOME}/playwright/profiles/default"],
          "enabled": true
        },

        // Parallel Search is a remote HTTP server, not an npm package; there is
        // no @parallel/search-mcp. Anonymous use is free at lower rate limits.
        "parallel-search": {
          "type": "remote",
          "url": "https://search.parallel.ai/mcp",
          "enabled": true
        }
      }
    }
  },

  // Deep-merged, key by key, into pi's ~/.pi/agent/settings.json last, so a key
  // here wins over the startup model the primary provider would give.
  "pi": {
    "overrides": {
      "defaultProvider": "Z.AI",
      "defaultModel": "glm-5.3-flash"
    }
  },

  // Keyed by the heading each group of providers sits under in OpenCode's model
  // dialog, beside OpenCode's own Zen and Go. A provider name is unique across
  // headings.
  //
  // "api" is "anthropic" (POST <BASE_URL>/v1/messages) or "openai"
  // (POST <BASE_URL>/v1/chat/completions), set per provider and overridable per
  // model.
  "providers": {

    "Subscriptions": {

      "deepseek": {
        "label": "DeepSeek",
        "API_KEY": "${DEEPSEEK_API_KEY}",
        "BASE_URL": "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}",
        "api": "anthropic",

        "defaults": {
          "context_window": 1000000,
          "max_tokens": 384000,
          "reasoning": true,
          "input": ["text"]
        },

        "models": [
          { "id": "deepseek-v4-pro", "tags": ["default"] },
          { "id": "deepseek-flash", "tags": ["small"] }
        ]
      },

      "glm": {
        "label": "Z.AI",
        "API_KEY": "${GLM_API_KEY}",
        "BASE_URL": "${GLM_BASE_URL:-https://api.z.ai/api/anthropic}",
        "api": "anthropic",

        "defaults": {
          "context_window": 1000000,
          "max_tokens": 131072,
          "reasoning": true,
          "input": ["text"]
        },

        "models": [
          // The "[1m]" ids exist only on the coding-plan route; this BASE_URL
          // rejects them with "modelCode: does not exist".
          { "id": "glm-5.3", "tags": ["default"] },
          { "id": "glm-5.3-flash", "tags": ["small"] }
        ]
      },

      "kimi": {
        "label": "Moonshot",
        "API_KEY": "${KIMI_API_KEY}",
        "BASE_URL": "${KIMI_BASE_URL:-https://api.kimi.com/coding}",
        "api": "anthropic",

        "defaults": {
          "context_window": 1048576,
          "max_tokens": 131072,
          "reasoning": true,
          "input": ["text", "image"]
        },

        "models": [
          { "id": "kimi-k3", "tags": ["default", "small"] }
        ]
      },

      "local": {
        "label": "Local",
        // llama-server takes no auth, but the CLIs require a non-empty value.
        "API_KEY": "${LOCAL_API_KEY:-local}",
        "BASE_URL": "${LOCAL_BASE_URL:-http://127.0.0.1:11301}",
        "api": "anthropic",

        "models": [
          // llama-server answers with whatever it has loaded and ignores the id,
          // so a fixed one survives swapping the model. context_window must stay
          // at or below the server's --ctx-size.
          {
            "id": "default",
            "tags": ["default", "small"],
            "context_window": 262144,
            "max_tokens": 32768,
            "reasoning": true,
            "input": ["text"]
          }
        ]
      },

      "gtr": {
        "label": "GTR9",
        // llama-server takes no auth unless started with --api-key, but the CLIs
        // require a non-empty value.
        "API_KEY": "${GTR_API_KEY:-gtr}",
        "BASE_URL": "${GTR9_BASE_URL:-https://gtr-halogen.spaghetti-monster.com}",
        // The shape the server answers: "openai" for /v1/chat/completions,
        // "anthropic" for /v1/messages. Overridable because the route it sits
        // behind may change.
        "api": "${GTR9_API:-openai}",

        // Cloudflare Access answers a request without these with a 302 to its
        // login page.
        "REQUEST_HEADERS": {
          "CF-Access-Client-Id": "${GTR_CF_ACCESS_CLIENT_ID}",
          "CF-Access-Client-Secret": "${GTR_CF_ACCESS_CLIENT_SECRET}"
        },

        "opencode": {
          // The window a session may grow into before OpenCode compacts it, not
          // the server's capacity: this server needs minutes to prefill more.
          "context_window": 16384,
          "max_tokens": 4096
        },

        "models": [
          // As with "local", the id is a label and context_window must stay at or
          // below the server's --ctx-size.
          {
            "id": "default",
            "tags": ["default", "small"],
            "context_window": 262144,
            "max_tokens": 32768,
            "reasoning": true,
            "input": ["text"]
          }
        ]
      }
    },

    "Command Code": {

      "commandcode": {
        "API_KEY": "${COMMAND_CODE_API_KEY}",
        "BASE_URL": "https://api.commandcode.ai/provider",
        // Claude is served only on /messages and everything else only on
        // /chat/completions; the wrong one answers 400.
        "api": "openai",

        // context_window is each model's context_length in
        // GET <BASE_URL>/v1/models. The catalog has no output limit.
        "defaults": {
          "max_tokens": 32000,
          "reasoning": true,
          "input": ["text"]
        },

        "models": [
          { "id": "deepseek/deepseek-v4.1-flash", "context_window": 1000000, "tags": ["default", "small"] },
          { "id": "moonshotai/Kimi-K3", "context_window": 1000000 },
          { "id": "z-ai/glm-5.3-flash", "context_window": 1048576 },

          { "id": "claude-fable-5-1", "api": "anthropic", "context_window": 1000000 },
          { "id": "claude-opus-5", "api": "anthropic", "context_window": 1000000 },
          { "id": "claude-sonnet-5", "api": "anthropic", "context_window": 1000000 },
          { "id": "claude-haiku-4-5-20251001", "api": "anthropic", "context_window": 200000 },

          { "id": "gpt-5.6-sol", "context_window": 1050000 },
          { "id": "gpt-5.6-terra", "context_window": 1050000 },
          { "id": "gpt-5.6-luna", "context_window": 1050000 },
          { "id": "gpt-5.3-codex", "context_window": 400000 },
          { "id": "deepseek/deepseek-v4-pro", "context_window": 1000000 },
          { "id": "zai-org/GLM-5.3", "context_window": 1000000 },
          { "id": "MiniMaxAI/MiniMax-M3", "context_window": 1000000 },
          { "id": "Qwen/Qwen3.8-Max", "context_window": 1000000 },
          { "id": "xiaomi/mimo-v2.5-pro", "context_window": 1000000 },
          { "id": "google/gemini-3.8-flash", "context_window": 1000000 },
          { "id": "xai/grok-4.6", "context_window": 500000 },
          { "id": "meta/muse-spark-1.3", "context_window": 1048576 },
          { "id": "meta/muse-spark-1.3-contributor", "context_window": 1048576 },

          { "id": "meituan/LongCat-2.0:free", "context_window": 1048576 },
          { "id": "poolside/laguna-s-2.1-free", "context_window": 256000 },
          { "id": "inclusionai/ling-3.0-flash-sante:free", "context_window": 262144 }
        ]
      }
    }
  }
}
