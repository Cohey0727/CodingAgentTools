// Every provider: its endpoint, the models it serves, and the tags naming the
// slot each model fills. "${NAME}" and "${NAME:-fallback}" resolve from the
// .env beside this file, so no secret is written here. Fields: see README.
//
// "agents" is what each CLI is fed. Nothing about a CLI or a provider is
// decided in bin/ — these values are the whole of it. In this section {name},
// {base_url} and {schema_id} stand for the provider being written.
{
  "start_provider": "glm",

  "agents": {

    "claude": {
      "command": "claude{name}",
      "stale_commands": ["pi{name}", "open{name}"],

      // What the generated launcher runs, and the variables it hands it. Every
      // name the CLI reads is here; the launcher itself knows none of them.
      "launch": {
        "exec": "claude",
        "token_var": "ANTHROPIC_AUTH_TOKEN",
        "base_url_var": "ANTHROPIC_BASE_URL",
        "headers_var": "ANTHROPIC_CUSTOM_HEADERS",
        "auto_compact_window_var": "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
        // Cleared before exec: set, it would shadow the token variable above.
        "unset_vars": ["ANTHROPIC_API_KEY"]
      },

      // Each of Claude Code's model variables, and the tags it follows, most
      // specific first. A variable with no tag of its own follows the roles.
      "slots": {
        "ANTHROPIC_MODEL":                ["default"],
        "ANTHROPIC_DEFAULT_OPUS_MODEL":   ["ANTHROPIC_DEFAULT_OPUS_MODEL", "default"],
        "ANTHROPIC_DEFAULT_SONNET_MODEL": ["ANTHROPIC_DEFAULT_SONNET_MODEL", "default"],
        "ANTHROPIC_DEFAULT_FABLE_MODEL":  ["ANTHROPIC_DEFAULT_FABLE_MODEL", "default"],
        "ANTHROPIC_DEFAULT_HAIKU_MODEL":  ["small", "default"],
        "CLAUDE_CODE_SUBAGENT_MODEL":     ["CLAUDE_CODE_SUBAGENT_MODEL", "small", "default"]
      },

      "auto_compact_window_from": "ANTHROPIC_MODEL"
    },

    "opencode": {
      "model_tag": "default",
      "small_model_tag": "small",

      // One entry per model in the generated block. Placeholders are the
      // model's own fields; a value that is exactly one placeholder keeps its
      // type. "keyed_by" makes the collection an object rather than an array.
      "model_entry": {
        "keyed_by": "{id}",
        "indent": 8,
        "inline": true,
        "value": { "limit": { "context": "{context_window}", "output": "{max_tokens}" } }
      },

      // What a provider's "schema": { "resolve": ... } selects.
      "schemas": {
        "local": {
          "id": "{name}-anthropic",
          "npm": "@ai-sdk/anthropic",
          // The AI SDK appends "/messages", BASE_URL is the form that gets
          // "/v1/messages" — so the two meet at BASE_URL plus "/v1".
          "base_url": "{base_url}/v1",
          "declare_models": true
        },
        "models.dev": { "id": "{schema_id}", "declare_models": false },
        "none": null
      },

      "lean": {
        "prompt": "bin/opencode-lean-prompt.md",
        // Only tools OpenCode registers may be listed: denying one it does not
        // know takes edit and write down with it.
        "disabled_tools": ["skill", "task", "todowrite", "webfetch"]
      }
    },

    "pi": {
      "model_tag": "default",
      "api": "anthropic-messages",

      // pi has no registry to resolve a catalog from, so every schema but
      // "none" declares the models below.
      "schemas": {
        "local":      { "id": "{name}", "declare_models": true },
        "models.dev": { "id": "{name}", "declare_models": true },
        "none":       null
      },

      "model_entry": {
        "indent": 8,
        "inline": false,
        "value": {
          "id": "{id}",
          "reasoning": "{reasoning}",
          "input": "{input}",
          "contextWindow": "{context_window}",
          "maxTokens": "{max_tokens}"
        }
      },

      "packages": { "npm:@realvendex/pi-loop": "/loop", "npm:pi-goal": "/goal" }
    }
  },

  "providers": {

    "deepseek": {
      "schema": { "resolve": "local" },
      "API_KEY": "${DEEPSEEK_API_KEY}",
      "BASE_URL": "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 384000,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" } },

      "models": [
        { "id": "deepseek-v4-pro", "tags": ["default"] },
        { "id": "deepseek-v4-flash", "tags": ["small"] },
        { "id": "deepseek-v4-flash-vision-exp", "input": ["text", "image"] },
        { "id": "deepseek-v4.1-flash-expires-on-0910" }
      ]
    },

    "glm": {
      "schema": { "resolve": "local" },
      "API_KEY": "${GLM_API_KEY}",
      "BASE_URL": "${GLM_BASE_URL:-https://api.z.ai/api/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" } },

      "models": [
        // The "[1m]" ids exist only on the coding-plan route; this BASE_URL
        // rejects them with "modelCode: does not exist".
        { "id": "glm-5.3", "tags": ["default"] },
        { "id": "glm-5.3-flash", "tags": ["small"] }
      ]
    },

    "kimi": {
      "schema": { "resolve": "local" },
      "API_KEY": "${KIMI_API_KEY}",
      "BASE_URL": "${KIMI_BASE_URL:-https://api.kimi.com/coding}",

      "defaults": {
        "context_window": 1048576,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text", "image"]
      },

      "claude": {
        "env": {
          "CLAUDE_CODE_EFFORT_LEVEL": "max",
          "ENABLE_TOOL_SEARCH": "false"
        }
      },

      "models": [
        { "id": "kimi-k3", "claude_id": "kimi-k3[1m]", "tags": ["default", "small"] }
      ]
    },

    "mimo": {
      "schema": { "resolve": "local" },
      "API_KEY": "${MIMO_API_KEY}",
      "BASE_URL": "${MIMO_BASE_URL:-https://token-plan-sgp.xiaomimimo.com/anthropic}",

      "defaults": {
        "context_window": 1048576,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": {
        "env": {
          "CLAUDE_CODE_EFFORT_LEVEL": "max",
          "ENABLE_TOOL_SEARCH": "false"
        }
      },

      "models": [
        { "id": "mimo-v2.5-pro", "claude_id": "mimo-v2.5-pro[1m]", "tags": ["default", "small"] }
      ]
    },

    "minimax": {
      "schema": { "resolve": "local" },
      "API_KEY": "${MINIMAX_API_KEY}",
      "BASE_URL": "${MINIMAX_BASE_URL:-https://api.minimax.io/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 128000,
        "reasoning": true,
        "input": ["text", "image"]
      },

      // Both bare names are taken on a typical machine: minimax -> the official
      // MiniMax Code app, mmx -> an unrelated bun tool.
      "claude": {
        "command": "claudemmx",
        "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" }
      },

      "models": [
        { "id": "MiniMax-M3", "tags": ["default", "small"] }
      ]
    },

    "local": {
      "schema": { "resolve": "local" },
      // llama-server takes no auth, but the CLIs require a non-empty value.
      "API_KEY": "${LOCAL_API_KEY:-local}",
      "BASE_URL": "${LOCAL_BASE_URL:-http://127.0.0.1:11301}",

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "low" } },

      "models": [
        // llama-server answers with whatever it has loaded and ignores the id,
        // so a fixed one survives swapping the model. context_window must stay
        // at or below the server's --ctx-size.
        {
          "id": "default",
          "tags": ["default", "small"],
          "context_window": 262144,
          "max_tokens": 32768,
          "reasoning": true,
          "input": ["text"]
        }
      ]
    },

    "gtr": {
      "schema": { "resolve": "local" },
      // llama-server takes no auth unless started with --api-key, but the CLIs
      // require a non-empty value.
      "API_KEY": "${GTR_API_KEY:-gtr}",
      "BASE_URL": "${GTR_BASE_URL:-https://gtr-llama.spaghetti-monster.com}",

      // Cloudflare Access answers a request without these with a 302 to its
      // login page.
      "REQUEST_HEADERS": {
        "CF-Access-Client-Id": "${GTR_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${GTR_CF_ACCESS_CLIENT_SECRET}"
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "low" } },

      "opencode": {
        "lean": true,

        // The window a session may grow into before OpenCode compacts it, not
        // the server's capacity: this server needs minutes to prefill more.
        "context_window": 16384,
        "max_tokens": 4096
      },

      "models": [
        // As with "local", the id is a label and context_window must stay at or
        // below the server's --ctx-size.
        {
          "id": "default",
          "tags": ["default", "small"],
          "context_window": 262144,
          "max_tokens": 32768,
          "reasoning": true,
          "input": ["text"]
        }
      ]
    }
  }
}
