// Every provider: its endpoint, the models it serves, and the tags naming the
// slot each model fills. "${NAME}" and "${NAME:-fallback}" resolve from the
// .env beside this file, so no secret is written here. Fields: see README.
{
  "providers": {

    "deepseek": {
      // models.dev がこの provider を知っているので、生成する設定はキーだけ。
      // npm・endpoint・モデル一覧・上限はレジストリが供給する。
      "schema": "models.dev",
      "API_KEY": "${DEEPSEEK_API_KEY}",
      "BASE_URL": "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 384000,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" } },

      "models": [
        { "id": "deepseek-v4-pro", "tags": ["default"] },
        { "id": "deepseek-v4-flash", "tags": ["small"] },
        { "id": "deepseek-v4-flash-vision-exp", "input": ["text", "image"] },
        { "id": "deepseek-v4.1-flash-expires-on-0910" }
      ]
    },

    "glm": {
      // The provider every generated config starts on. At most one may say so.
      "primary": true,
      // models.dev knows this one under a different name. It must be the
      // coding-plan entry: the plain "zai" one is the metered route, and a
      // subscription key has no balance there.
      "schema": "models.dev",
      "schema_id": "zai-coding-plan",
      "API_KEY": "${GLM_API_KEY}",
      "BASE_URL": "${GLM_BASE_URL:-https://api.z.ai/api/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" } },

      "models": [
        // The "[1m]" ids exist only on the coding-plan route; this BASE_URL
        // rejects them with "modelCode: does not exist".
        { "id": "glm-5.3", "tags": ["default"] },
        { "id": "glm-5.3-flash", "tags": ["small"] }
      ]
    },

    "kimi": {
      "API_KEY": "${KIMI_API_KEY}",
      "BASE_URL": "${KIMI_BASE_URL:-https://api.kimi.com/coding}",

      "defaults": {
        "context_window": 1048576,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text", "image"]
      },

      "claude": {
        "env": {
          "CLAUDE_CODE_EFFORT_LEVEL": "max",
          "ENABLE_TOOL_SEARCH": "false"
        }
      },

      "models": [
        { "id": "kimi-k3", "claude_id": "kimi-k3[1m]", "tags": ["default", "small"] }
      ]
    },

    "mimo": {
      "API_KEY": "${MIMO_API_KEY}",
      "BASE_URL": "${MIMO_BASE_URL:-https://token-plan-sgp.xiaomimimo.com/anthropic}",

      "defaults": {
        "context_window": 1048576,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": {
        "env": {
          "CLAUDE_CODE_EFFORT_LEVEL": "max",
          "ENABLE_TOOL_SEARCH": "false"
        }
      },

      "models": [
        { "id": "mimo-v2.5-pro", "claude_id": "mimo-v2.5-pro[1m]", "tags": ["default", "small"] }
      ]
    },

    "minimax": {
      // models.dev lists the same Anthropic endpoint BASE_URL points at.
      "schema": "models.dev",
      "API_KEY": "${MINIMAX_API_KEY}",
      "BASE_URL": "${MINIMAX_BASE_URL:-https://api.minimax.io/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 128000,
        "reasoning": true,
        "input": ["text", "image"]
      },

      // Both bare names are taken on a typical machine: minimax -> the official
      // MiniMax Code app, mmx -> an unrelated bun tool.
      "claude": {
        "command": "claudemmx",
        "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" }
      },

      "models": [
        { "id": "MiniMax-M3", "tags": ["default", "small"] }
      ]
    },

    "local": {
      // llama-server takes no auth, but the CLIs require a non-empty value.
      "API_KEY": "${LOCAL_API_KEY:-local}",
      "BASE_URL": "${LOCAL_BASE_URL:-http://127.0.0.1:11301}",

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "low" } },

      "models": [
        // llama-server answers with whatever it has loaded and ignores the id,
        // so a fixed one survives swapping the model. context_window must stay
        // at or below the server's --ctx-size.
        {
          "id": "default",
          "tags": ["default", "small"],
          "context_window": 262144,
          "max_tokens": 32768,
          "reasoning": true,
          "input": ["text"]
        }
      ]
    },

    "gtr": {
      // llama-server takes no auth unless started with --api-key, but the CLIs
      // require a non-empty value.
      "API_KEY": "${GTR_API_KEY:-gtr}",
      "BASE_URL": "${GTR_BASE_URL:-https://gtr-llama.spaghetti-monster.com}",

      // Cloudflare Access answers a request without these with a 302 to its
      // login page.
      "REQUEST_HEADERS": {
        "CF-Access-Client-Id": "${GTR_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${GTR_CF_ACCESS_CLIENT_SECRET}"
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "low" } },

      "opencode": {
        "lean": true,

        // The window a session may grow into before OpenCode compacts it, not
        // the server's capacity: this server needs minutes to prefill more.
        "context_window": 16384,
        "max_tokens": 4096
      },

      "models": [
        // As with "local", the id is a label and context_window must stay at or
        // below the server's --ctx-size.
        {
          "id": "default",
          "tags": ["default", "small"],
          "context_window": 262144,
          "max_tokens": 32768,
          "reasoning": true,
          "input": ["text"]
        }
      ]
    }
  }
}
